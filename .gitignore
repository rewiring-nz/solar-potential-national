.venv
.env
__pycache__/
*.pyc

# name, never with -A.

# WHITELIST, not a blacklist. Everything under data/ is pipeline input or
# intermediate (LiDAR, imagery mosaics, 80MB+ panel_layouts.geojson) EXCEPT the
# handful of small outputs the static site actually fetches. A blacklist let
# `git add -A data` commit two 86MB intermediates on 31 Aug; a whitelist cannot.
data/*
!data/solar_potential.geojson
!data/panel_layouts.pmtiles
!data/seasonal_curves.json
!data/heatmaps/
!data/heatmaps/*
!data/heatmaps/lod/
!data/heatmaps/lod/*
